<%- include('partials/head', { title: 'পরীক্ষার ফলাফল সম্পূর্ণ গাইড ২০২৬ — ফলাফল সেতু', description: 'বাংলাদেশের সকল পরীক্ষার ফলাফল দেখার সম্পূর্ণ গাইড: অনলাইন পদ্ধতি, এসএমএস নিয়ম, মার্কশিট ডাউনলোড, বোর্ড চ্যালেঞ্জ, গ্রেডিং সিস্টেম ও সাধারণ সমস্যা সমাধান।', canonical: '/guide', ogType: 'website' }) %>

<body>
  <%- include('partials/header', { activePage: 'guide' }) %>

  <main>
    <div class="page-hero">
      <div class="page-hero-inner">
        <h1 class="page-title">পরীক্ষার ফলাফল সম্পূর্ণ গাইড ২০২৬</h1>
        <p class="page-subtitle">এসএসসি, এইচএসসি, এনইউ, মেডিকেল, বিসিএস, এনটিআরসিএ, বিশ্ববিদ্যালয় ভর্তি — সব পরীক্ষার ফলাফল দেখার পূর্ণাঙ্গ নির্দেশিকা</p>
      </div>
    </div>

    <section class="result-grid">
      <div class="result-card main-board">
        <div class="result-card-header">
          <span class="badge">🌐 অনলাইনে ফলাফল দেখার পদ্ধতি</span>
          <h2>সার্বিক পদ্ধতি (সব বোর্ডের জন্য)</h2>
        </div>
        <div class="guide-steps">
          <div class="guide-step">
            <span class="step-badge">১</span>
            <div>
              <h4>অফিসিয়াল পোর্টালে যান</h4>
              <p><strong>eboardresults.com</strong> (প্রধান) বা <strong>educationboardresults.gov.bd</strong> (সরকারি আর্কাইভ)</p>
            </div>
          </div>
          <div class="guide-step">
            <span class="step-badge">২</span>
            <div>
              <h4>পরীক্ষা ও বছর নির্বাচন করুন</h4>
              <p>Examination: SSC/HSC/Dakhil/Alim | Year: ২০২৬ (আপনার পরীক্ষার বছর)</p>
            </div>
          </div>
          <div class="guide-step">
            <span class="step-badge">৩</span>
            <div>
              <h4>শিক্ষা বোর্ড নির্বাচন করুন</h4>
              <p>আপনার বোর্ড: ঢাকা/রাজশাহী/কুমিল্লা/যশোর/চট্টগ্রাম/বরিশাল/সিলেট/দিনাজপুর/ময়মনসিংহ/মাদ্রাসা/কারিগরি</p>
            </div>
          </div>
          <div class="guide-step">
            <span class="step-badge">৪</span>
            <div>
              <h4>রোল ও রেজিস্ট্রেশন নম্বর দিন</h4>
              <p>অ্যাডমিট কার্ড থেকে সঠিক রোল নম্বর এবং রেজিস্ট্রেশন নম্বর ইনপুট করুন</p>
            </div>
          </div>
          <div class="guide-step">
            <span class="step-badge">৫</span>
            <div>
              <h4>ক্যাপচা পূরণ করে ফলাফল দেখুন</h4>
              <p>৪ অঙ্কের সিকিউরিটি কোড লিখে Submit/Get Result ক্লিক করুন — ফুল মার্কশিট দেখাবে</p>
            </div>
          </div>
        </div>
      </div>

      <div class="result-card">
        <div class="result-card-header">
          <span class="badge">📱 ১৬২২২ এসএমএস পদ্ধতি</span>
          <h2>মোবাইল থেকে ফলাফল (টেলিটক প্রিপেইড)</h2>
        </div>
        <div class="sms-format">
          <h4>সাধারণ ফরম্যাট:</h4>
          <code><পরীক্ষা> <বোর্ড ৩ অক্ষর> <রোল> <সাল></code>
          <p><strong>উদাহরণ:</strong> SSC DHA 123456 2026 → পাঠান ১৬২২২ নম্বরে</p>
          
          <h4>প্রধান পরীক্ষার কোড:</h4>
          <ul class="feature-list">
            <li>SSC / HSC / Dakhil / Alim — বোর্ড কোড (DHA, RAJ, COM, JES, CHI, BAR, SYL, DIN, MYM, MAD, TEC)</li>
            <li>GST — গুচ্ছ বিশ্ববিদ্যালয় ভর্তি</li>
            <li>DU/BUET/CU/RU/NSU/KU — পৃথক বিশ্ববিদ্যালয় ভর্তি</li>
            <li>MBBS / BDS — মেডিকেল/ডেন্টাল ভর্তি</li>
            <li>NU HON/DEG/MAS — জাতীয় বিশ্ববিদ্যালয়</li>
            <li>BCS PRE/WRI/VIV — বিসিএস পরীক্ষা</li>
            <li>NTRCA PRE/WRI — এনটিআরসিএ</li>
          </ul>
        </div>
      </div>

      <div class="result-card">
        <div class="result-card-header">
          <span class="badge">📄 মার্কশিট ডাউনলোড</span>
          <h2>পূর্ণাঙ্গ বিষয়ভিত্তিক নম্বরপত্র</h2>
        </div>
        <ul class="feature-list">
          <li><strong>Individual Result:</strong> eboardresults.com-এ 'Individual Result' বাটনে ক্লিক করুন</li>
          <li><strong>রেজিস্ট্রেশন নম্বর আবশ্যক:</strong> পূর্ণ মার্কশিটের জন্য রেজি নম্বর দিতে হয়</li>
          <li><strong>পিডিএফ সেভ:</strong> ফলাফল পেইজ থেকে Ctrl+P → Save as PDF বেছে নিন</li>
          <li><strong>প্রিন্ট:</strong> সরাসরি প্রিন্টারে পাঠিয়ে হার্ড কপি নিন</li>
          <li><strong>Institution Result (EIIN):</strong> স্কুল/কলেজের পুরো রেজাল্ট শিট পিডিএফ ডাউনলোড করতে EIIN নম্বর দিন</li>
        </ul>
      </div>

      <div class="result-card">
        <div class="result-card-header">
          <span class="badge">🔄 বোর্ড চ্যালেঞ্জ / পুনঃনিরীক্ষণ</span>
          <h2>খাতা রিচেক করার নিয়ম</h2>
        </div>
        <div class="sms-format">
          <h4>ধাপ ১: আবেদন</h4>
          <code>RSC <বোর্ড ৩ অক্ষর> <রোল> <বিষয় কোড></code>
          <p>উদাহরণ: RSC DHA 123456 101 → ১৬২২২ নম্বরে (টেলিটক প্রিপেইড)</p>
          
          <h4>ধাপ ২: কনফার্মেশন</h4>
          <code>RSC YES <পিন> <ফোন নম্বর></code>
          <p>পিন পাওয়ার ২৪ ঘণ্টার মধ্যে কনফার্ম করুন</p>
        </div>
        <ul class="tips-list">
          <li><strong>ফি:</strong> ১২৫ টাকা/বিষয় (ভ্যাটসহ)</li>
          <li><strong>সময়:</strong> ফলাফল প্রকাশের ৭ দিনের মধ্যে</li>
          <li><strong>নম্বর কমে যায় না:</strong> পুনঃনিরীক্ষণে নম্বর বাড়ে অথবা অপরিবর্তিত থাকে</li>
        </ul>
      </div>

      <div class="result-card">
        <div class="result-card-header">
          <span class="badge">📊 গ্রেডিং সিস্টেম (GPA/CGPA)</span>
          <h2>জিপিএ ও সিজিপিএ হিসাব</h2>
        </div>
        <div class="table-wrapper">
          <table class="grade-table">
            <thead>
              <tr><th>মার্কস</th><th>লেটার গ্রেড</th><th>গ্রেড পয়েন্ট</th></tr>
            </thead>
            <tbody>
              <tr><td>৮০-১০০</td><td>A+</td><td>৫.০০</td></tr>
              <tr><td>৭০-৭৯</td><td>A</td><td>৪.০০</td></tr>
              <tr><td>৬০-৬৯</td><td>A-</td><td>৩.৫০</td></tr>
              <tr><td>৫০-৫৯</td><td>B</td><td>৩.০০</td></tr>
              <tr><td>৪০-৪৯</td><td>C</td><td>২.০০</td></tr>
              <tr><td>৩৩-৩৯</td><td>D</td><td>১.০০</td></tr>
              <tr><td>০-৩২</td><td>F</td><td>০.০০</td></tr>
            </tbody>
          </table>
        </div>
        <p class="table-note"><strong>GPA Formula:</strong> (৫টি মূল বিষয় GP + ৪র্থ বিষয়ের অতিরিক্ত GP) ÷ ৫ | <strong>৪র্থ বিষয়:</strong> GP ২.০০ বাদ দিয়ে বাকি যোগ হয়</p>
      </div>

      <div class="result-card">
        <div class="result-card-header">
          <span class="badge">⚠️ সাধারণ সমস্যা ও সমাধান</span>
          <h2>ট্রাবলশুটিং গাইড</h2>
        </div>
        <ul class="tips-list">
          <li><strong>সার্ভার ডাউন/স্লো:</strong> ফলাফল প্রকাশের দিন ট্রাফিকের কারণে সার্ভার ব্যস্ত থাকে। কিছুক্ষণ অপেক্ষা করুন, রিফ্রেশ করুন, বা বিকল্প পোর্টাল (educationboardresults.gov.bd) চেষ্টা করুন।</li>
          <li><strong>৫০২/৫০৪ এরর:</strong> ব্রাউজার ক্যাশ ক্লিয়ার করুন (Ctrl+Shift+Delete), ইনকগনিটো মোডে চেষ্টা করুন, বা ভিপিএন বন্ধ রাখুন।</li>
          <li><strong>রোল/রেজি নম্বর ভুল:</strong> অ্যাডমিট কার্ড থেকে আবার চেক করুন। স্পেস বা ড্যাশ ছাড়া শুধু সংখ্যা দিন।</li>
          <li><strong>রেজিস্ট্রেশন নম্বর নেই:</strong> স্কুল/কলেজ অফিস থেকে ট্যাবুলেশন শিট বা রেজি কার্ড থেকে নিন।</li>
          <li><strong>পুরনো বছরের রেজাল্ট (১৯৯৬-২০২৫):</strong> eboardresults.com-এسال ড্রপডাউন থেকে পুরনো সাল সিলেক্ট করুন।</li>
          <li><strong>এসএমএস আসছে না:</strong> শুধু টেলিটক প্রিপেইড সিম থেকে পাঠান। নেটওয়ার্ক ব্যস্ত থাকলে ১০-৩০ মিনিট অপেক্ষা করুন।</li>
        </ul>
      </div>

      <div class="result-card">
        <div class="result-card-header">
          <span class="badge">🎓 বিভাগভিত্তিক কুইক লিংক</span>
          <h2>পরীক্ষা প্রকার অনুযায়ী ডায়রেক্ট লিংক</h2>
        </div>
        <div class="quick-links-grid">
          <a href="/ssc-result" class="quick-link">🏫 এসএসসি/দাখিল রেজাল্ট</a>
          <a href="/hsc-result" class="quick-link">📝 এইচএসসি/আলিম রেজাল্ট</a>
          <a href="/university-admission" class="quick-link">🏛️ বিশ্ববিদ্যালয় ভর্তি ফলাফল</a>
          <a href="/medical-admission" class="quick-link">🏥 মেডিকেল/ডেন্টাল ভর্তি</a>
          <a href="/nu-result" class="quick-link">📚 জাতীয় বিশ্ববিদ্যালয় (NU)</a>
          <a href="/bcs-result" class="quick-link">💼 বিসিএস রেজাল্ট</a>
          <a href="/ntrca-result" class="quick-link">📝 এনটিআরসিএ রেজাল্ট</a>
          <a href="/primary-result" class="quick-link">👨‍🏫 প্রাথমিক শিক্ষক নিয়োগ</a>
          <a href="/sms-result" class="quick-link">📱 ১৬২২২ এসএমএস গাইড</a>
          <a href="/grading-system" class="quick-link">📊 গ্রেডিং সিস্টেম/জিপিএ</a>
          <a href="/board-challenge" class="quick-link">🔄 বোর্ড চ্যালেঞ্জ/রিচেক</a>
          <a href="/education-boards" class="quick-link">🏫 ১১টি শিক্ষা বোর্ড লিংক</a>
        </div>
      </div>

      <div class="result-card info-section">
        <h2>📞 আরও সাহায্য দরকার?</h2>
        <p>উপরের গাইডগুলো পড়েও সমস্যা সমাধান না হলে <a href="/contact">যোগাযোগ পেজে</a> বার্তা পাঠান। আমরা ২৪-৪৮ ঘণ্টার মধ্যে উত্তর দেব।</p>
        <p style="margin-top: 12px;"><strong>ফলাফল সেতু (ExamResultsBD)</strong> — বাংলাদেশের পরীক্ষার্থীদের সাথে সবসময়।</p>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>