<%- include('partials/head', { title: 'মেডিকেল ও ডেন্টাল ভর্তি ফলাফল ২০২৬ — ফলাফল সেতু', description: 'এমবিবিএস ও বিডিএস ভর্তি পরীক্ষার ফলাফল — ডিজিএইচএস অফিসিয়াল পোর্টাল, মেধা স্কোর, মেধা তালিকা ও সরকারি/বেসরকারি মেডিকেল কলেজ বরাদ্দ।', canonical: '/medical-admission', ogType: 'website' }) %>

<body>
  <%- include('partials/header', { activePage: 'medical' }) %>

  <main>
    <div class="page-hero">
      <div class="page-hero-inner">
        <h1 class="page-title">মেডিকেল ও ডেন্টাল ভর্তি ফলাফল ২০২৬</h1>
        <p class="page-subtitle">স্বাস্থ্য অধিদপ্তর (DGHS) অধীন সরকারি ও বেসরকারি মেডিকেল/ডেন্টাল কলেজ ভর্তি পরীক্ষা</p>
      </div>
    </div>

    <section class="result-grid">
      <div class="result-card main-board">
        <div class="result-card-header">
          <span class="badge">🏥 অফিসিয়াল পোর্টাল</span>
          <h2>DGHS ভর্তি ফলাফল</h2>
        </div>
        <div class="result-links">
          <a href="https://result.dghs.gov.bd" target="_blank" rel="noopener" class="result-link primary">
            <span class="link-icon">🌐</span>
            <div>
              <strong>result.dghs.gov.bd</strong>
              <small>মেডিকেল/ডেন্টাল ভর্তি ফলাফল অফিসিয়াল সার্ভার</small>
            </div>
          </a>
          <a href="https://www.dghs.gov.bd" target="_blank" rel="noopener" class="result-link">
            <span class="link-icon">🏛️</span>
            <div>
              <strong>DGHS.gov.bd</strong>
              <small>স্বাস্থ্য অধিদপ্তর মূল ওয়েবসাইট</small>
            </div>
          </a>
        </div>
      </div>

      <div class="result-card">
        <div class="result-card-header">
          <span class="badge">📊 ফলাফল ধরণ</span>
          <h2>প্রকাশিত তথ্যগুলো</h2>
        </div>
        <ul class="feature-list">
          <li><strong>মেধা স্কোর:</strong> প্রতিটি প্রার্থীর প্রাপ্ত মোট স্কোর (১০০ পূর্ণ নম্বর)</li>
          <li><strong>মেধা তালিকা:</strong> সাধারণ মেরিট পজিশন (General Merit Position)</li>
          <li><strong>বিভাগীয় মেধা:</strong> বিভাগভিত্তিক আলাদা মেধা তালিকা</li>
          <li><strong>কলেজ বরাদ্দ:</strong> সরকারি/বেসরকারি মেডিকেল ও ডেন্টাল কলেজ বরাদ্দ</li>
          <li><strong>মুক্তিযোদ্ধা কোটা/আদিবাসি কোটা:</strong> বিশেষ কোটাভিত্তিক আলাদা তালিকা</li>
        </ul>
      </div>

      <div class="result-card">
        <div class="result-card-header">
          <span class="badge">📱 এসএমএস পদ্ধতি</span>
          <h2>১৬২২২ এসএমএস ফরম্যাট</h2>
        </div>
        <div class="sms-format">
          <code>MBBS <রোল> <সাল></code>
          <p>উদাহরণ: <strong>MBBS 123456 2026</strong> পাঠান <strong>১৬২২২</strong> নম্বরে</p>
          <p>BDS-এর জন্যও একই ফরম্যাট: <strong>BDS <রোল> <সাল></strong></p>
        </div>
      </div>

      <div class="result-card">
        <div class="result-card-header">
          <span class="badge">🏥 কলেজ শ্রেণিবিন্যাস</span>
          <h2>বরাদ্দ পরিসংখ্যান</h2>
        </div>
        <div class="stats-grid">
          <div class="stat-box">
            <span class="stat-number">৩৮</span>
            <span class="stat-label">সরकारी মেডিকেল কলেজ</span>
          </div>
          <div class="stat-box">
            <span class="stat-number">১১</span>
            <span class="stat-label">সরकारी ডেন্টাল কলেজ</span>
          </div>
          <div class="stat-box">
            <span class="stat-number">৭০+</span>
            <span class="stat-label">বেসরকারি মেডিকেল কলেজ</span>
          </div>
          <div class="stat-box">
            <span class="stat-number">২৫+</span>
            <span class="stat-label">বেসরকারি ডেন্টাল কলেজ</span>
          </div>
        </div>
      </div>

      <div class="result-card">
        <div class="result-card-header">
          <span class="badge">🩺 নার্সিং ও মিডওয়াইফারি</span>
          <h2>BNMC ভর্তি ফলাফল</h2>
        </div>
        <div class="result-links">
          <a href="https://www.bnmc.gov.bd" target="_blank" rel="noopener" class="result-link">
            <span class="link-icon">🩺</span>
            <div>
              <strong>BNMC.gov.bd</strong>
              <small>বাংলাদেশ নার্সিং ও মিডওয়াইফারি কাউন্সিল</small>
            </div>
          </a>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>