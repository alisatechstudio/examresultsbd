<%- include('partials/head', { title: 'বিসিএস রেজাল্ট ২০২৬ (BCS Result) — ফলাফল সেতু', description: 'বাংলাদেশ সরকারি কর্ম কমিশন (BPSC) বিসিএস পরীক্ষার ফলাফল — প্রিলিমিনারি, লিখিত, ভাইভা ও চূড়ান্ত মেধা তালিকা। অফিসিয়াল লিংক ও এসএমএস নিয়ম।', canonical: '/bcs-result', ogType: 'website' }) %>

<body>
  <%- include('partials/header', { activePage: 'bcs' }) %>

  <main>
    <div class="page-hero">
      <div class="page-hero-inner">
        <h1 class="page-title">বিসিএস রেজাল্ট ২০২৬ (BCS Result)</h1>
        <p class="page-subtitle">বাংলাদেশ সরকারি কর্ম কমিশন (BPSC) — ৪৫তম থেকে বর্তমান বিসিএস পরীক্ষার সকল ফলাফল</p>
      </div>
    </div>

    <section class="result-grid">
      <div class="result-card main-board">
        <div class="result-card-header">
          <span class="badge">💼 অফিসিয়াল পোর্টাল</span>
          <h2>BPSC বিসিএস ফলাফল</h2>
        </div>
        <div class="result-links">
          <a href="https://www.bpsc.gov.bd" target="_blank" rel="noopener" class="result-link primary">
            <span class="link-icon">🌐</span>
            <div>
              <strong>bpsc.gov.bd</strong>
              <small>বিপিএসসি অফিসিয়াল ওয়েবসাইট · প্রেস বিজ্ঞপ্তি</small>
            </div>
          </a>
          <a href="https://bpsc.teletalk.com.bd" target="_blank" rel="noopener" class="result-link">
            <span class="link-icon">📱</span>
            <div>
              <strong>bpsc.teletalk.com.bd</strong>
              <small>টেলিটক পোর্টাল · অ্যাপ্লিকেশন/এডমিট/ফলাফল</small>
            </div>
          </a>
        </div>
      </div>

      <div class="result-card">
        <div class="result-card-header">
          <span class="badge">📊 ফলাফল ধাপাবলী</span>
          <h2>বিসিএস পরীক্ষার ধাপ</h2>
        </div>
        <div class="step-grid">
          <div class="step-item">
            <span class="step-number">১</span>
            <h3>প্রিলিমিনারি (Preliminary)</h3>
            <p>এমসিকিউ ভিত্তিক স্ক্রিনিং টেস্ট ফলাফল</p>
          </div>
          <div class="step-item">
            <span class="step-number">২</span>
            <h3>লিখিত (Written)</h3>
            <p>বিষয়ভিত্তিক লিখিত পরীক্ষার ফলাফল</p>
          </div>
          <div class="step-item">
            <span class="step-number">৩</span>
            <h3>ভাইভা (Viva Voce)</h3>
            <p>মৌখিক পরীক্ষার ফলাফল ও নম্বর</p>
          </div>
          <div class="step-item">
            <span class="step-number">৪</span>
            <h3>চূড়ান্ত মেধা তালিকা</h3>
            <p>ক্যাডরভিত্তিক শেষ সুপারিশ তালিকা</p>
          </div>
        </div>
      </div>

      <div class="result-card">
        <div class="result-card-header">
          <span class="badge">📱 এসএমএস পদ্ধতি</span>
          <h2>১৬২২২ এসএমএস ফরম্যাট</h2>
        </div>
        <div class="sms-format">
          <code>BCS <পরীক্ষার ধরন> <রোল> <সাল></code>
          <p>প্রিলিমিনারি: <strong>BCS PRE 123456 2026</strong></p>
          <p>লিখিত: <strong>BCS WRI 123456 2026</strong></p>
          <p>ভাইভা: <strong>BCS VIV 123456 2026</strong></p>
          <p>সবই পাঠান <strong>১৬২২২</strong> নম্বরে (টেলিটক প্রিপেইড)</p>
        </div>
      </div>

      <div class="result-card">
        <div class="result-card-header">
          <span class="badge">🏛️ ক্যাডর ভিত্তিক ফলাফল</span>
          <h2>২৭টি ক্যাডার</h2>
        </div>
        <div class="board-grid">
          <a href="https://www.bpsc.gov.bd" target="_blank" rel="noopener" class="board-link">প্রশাসন ক্যাডার</a>
          <a href="https://www.bpsc.gov.bd" target="_blank" rel="noopener" class="board-link">পুলিশ ক্যাডার</a>
          <a href="https://www.bpsc.gov.bd" target="_blank" rel="noopener" class="board-link">বিদেশ ক্যাডার</a>
          <a href="https://www.bpsc.gov.bd" target="_blank" rel="noopener" class="board-link">তথ্য ক্যাডার</a>
          <a href="https://www.bpsc.gov.bd" target="_blank" rel="noopener" class="board-link">সহযোগিতা ক্যাডার</a>
          <a href="https://www.bpsc.gov.bd" target="_blank" rel="noopener" class="board-link">রেলওয়ে ক্যাডার</a>
          <a href="https://www.bpsc.gov.bd" target="_blank" rel="noopener" class="board-link">বাণিজ্য ক্যাডার</a>
          <a href="https://www.bpsc.gov.bd" target="_blank" rel="noopener" class="board-link">শিক্ষা ক্যাডার</a>
          <a href="https://www.bpsc.gov.bd" target="_blank" rel="noopener" class="board-link">অন্যান্য ক্যাডার</a>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>