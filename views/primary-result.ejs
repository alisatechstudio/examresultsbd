<%- include('partials/head', { title: 'প্রাথমিক শিক্ষক নিয়োগ পরীক্ষা রেজাল্ট ২০২৬ — ফলাফল সেতু', description: 'প্রাথমিক শিক্ষক নিয়োগ পরীক্ষার ফলাফল, লিখিত ও ভাইভা রেজাল্ট, মেধা তালিকা এবং অফিসিয়াল পোর্টাল লিংক।', canonical: '/primary-result', ogType: 'website' }) %>

<body>
  <%- include('partials/header', { activePage: 'primary' }) %>

  <main>
    <div class="page-hero">
      <div class="page-hero-inner">
        <h1 class="page-title">প্রাথমিক শিক্ষক নিয়োগ পরীক্ষা রেজাল্ট</h1>
        <p class="page-subtitle">বাংলাদেশ সরকার초등 ও গণশিক্ষা মন্ত্রণালয় অধীন প্রाथমিক শিক্ষা অধিদপ্তর</p>
      </div>
    </div>

    <section class="result-grid">
      <div class="result-card main-board">
        <div class="result-card-header">
          <span class="badge">📋 অফিসিয়াল পোর্টাল</span>
          <h2>প্রাথমিক শিক্ষক নিয়োগ ফলাফল</h2>
        </div>
        <div class="result-links">
          <a href="https://www.dpe.gov.bd" target="_blank" rel="noopener" class="result-link primary">
            <span class="link-icon">🌐</span>
            <div>
              <strong>DPE.gov.bd</strong>
              <small>প্রাথমিক শিক্ষা অধিদপ্তর অফিসিয়াল ওয়েবসাইট</small>
            </div>
          </a>
          <a href="https://www.dpe.teletalk.com.bd" target="_blank" rel="noopener" class="result-link">
            <span class="link-icon">📱</span>
            <div>
              <strong>DPE Teletalk</strong>
              <small>অ্যাপ্লিকেশন ও এডমিট কার্ড পোর্টাল</small>
            </div>
          </a>
        </div>
      </div>

      <div class="result-card">
        <div class="result-card-header">
          <span class="badge">📊 ফলাফল ধরণ</span>
          <h2>পরীক্ষার ধাপাবলী</h2>
        </div>
        <div class="step-grid">
          <div class="step-item">
            <span class="step-number">১</span>
            <h3>পিইসি/ইবিটি ফলাফল</h3>
            <p>প্রাথমিক শিক্ষা সমাপনী ও ইবিটি পরীক্ষার ফলাফল</p>
          </div>
          <div class="step-item">
            <span class="step-number">২</span>
            <h3>লিখিত পরীক্ষা ফলাফল</strong></h3>
            <p>সহকারী শিক্ষক নিয়োগ লিখিত পরীক্ষার ফলাফল</p>
          </div>
          <div class="step-item">
            <span class="step-number">৩</span>
            <h3>ভাইভা/মৌখিক ফলাফল</h3>
            <p>সফল প্রার্থীদের ভাইভা ফলাফল ও মেধা তালিকা</p>
          </div>
          <div class="step-item">
            <span class="step-number">৪</span>
            <h3>শেষ মেধা তালিকা</h3>
            <p>জেলাভিত্তিক শেষ নিয়োগ সুপারিশ তালিকা</p>
          </div>
        </div>
      </div>

      <div class="result-card">
        <div class="result-card-header">
          <span class="badge">🔍 ফলাফল চেক পদ্ধতি</span>
          <h2>কীভাবে ফলাফল দেখবেন</h2>
        </div>
        <div class="guide-steps">
          <div class="guide-step">
            <span class="step-badge">১</span>
            <div>
              <h4>DPE.gov.bd-এ প্রবেশ করুন</h4>
              <p>ব্রাউজারে dpe.gov.bd টাইপ করুন</p>
            </div>
          </div>
          <div class="guide-step">
            <span class="step-badge">২</span>
            <div>
              <h4>'পরীক্ষার ফলাফল' মেনু নির্বাচন করুন</h4>
              <p>হোমপেজ থেকে 'নিয়োগ পরীক্ষার ফলাফল' অপশনে ক্লিক করুন</p>
            </div>
          </div>
          <div class="guide-step">
            <span class="step-badge">৩</span>
            <div>
              <h4>রোল ও রেজিস্ট্রেশন নম্বর দিন</h4>
              <p>আপনার অ্যাডমিট কার্ড অনুযায়ী তথ্য ইনপুট করুন</p>
            </div>
          </div>
          <div class="guide-step">
            <span class="step-badge">৪</span>
            <div>
              <h4>ফলাফল ডাউনলোড/প্রিন্ট করুন</h4>
              <p>প্রদর্শিত ফলাফলটি পিডিএফ আকারে সংরক্ষণ করুন</p>
            </div>
          </div>
        </div>
      </div>

      <div class="result-card">
        <div class="result-card-header">
          <span class="badge">📞 যোগাযোগ</span>
          <h2>প্রশ্ন থাকলে</h2>
        </div>
        <p>প্রাথমিক শিক্ষক নিয়োগ সংক্রান্ত যেকোনো প্রশ্নের জন্য <a href="/contact">যোগাযোগ পেজে</a> বার্তা পাঠান।</p>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>