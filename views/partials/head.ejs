<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<meta name="description" content="<%= description %>">
<meta name="robots" content="index, follow">
<meta name="author" content="ফলাফল সেতু">
<link rel="canonical" href="https://examresultsbd.online<%= canonical %>">

<!-- Open Graph / Social -->
<meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
<meta property="og:url" content="https://examresultsbd.online<%= canonical %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:image" content="https://examresultsbd.online/logo.png">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://examresultsbd.online/logo.png">

<!-- Favicon & PWA -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" sizes="96x96" href="/favicon.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#0B4D3B">

<!-- Performance Preconnect & DNS-Prefetch Hints -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://www.googletagmanager.com">
<link rel="preconnect" href="https://www.clarity.ms">

<!-- Google Fonts (non-blocking) -->
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fraunces:wght@700&family=Hind+Siliguri:wght@400;600;700&family=JetBrains+Mono:wght@500;700&family=Plus+Jakarta+Sans:wght@500;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:wght@700&family=Hind+Siliguri:wght@400;600;700&family=JetBrains+Mono:wght@500;700&family=Plus+Jakarta+Sans:wght@500;700&display=swap" media="print" onload="this.onload=null;this.media='all'">
<noscript>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:wght@700&family=Hind+Siliguri:wght@400;600;700&family=JetBrains+Mono:wght@500;700&family=Plus+Jakarta+Sans:wght@500;700&display=swap">
</noscript>

<!-- Main Stylesheet -->
<link rel="preload" href="/style.css" as="style">
<link rel="stylesheet" href="/style.css">

<!-- Google Consent Mode v2 & GDPR Consent Settings -->
<script src="/gdpr-consent.js"></script>
<script>
  gtag('js', new Date());
  gtag('config', 'G-WLR2CV579C');

  (function() {
    let thirdPartyLoaded = false;
    function loadThirdParty() {
      if (thirdPartyLoaded) return;
      thirdPartyLoaded = true;

      // Google Analytics (gtag.js)
      const gScript = document.createElement('script');
      gScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-WLR2CV579C';
      gScript.async = true;
      document.head.appendChild(gScript);
    }

    const triggerEvents = ['scroll', 'touchstart', 'click', 'keydown', 'wheel'];
    triggerEvents.forEach(function(evt) {
      window.addEventListener(evt, loadThirdParty, { once: true, passive: true });
    });

    // Fallback timer for passive readers who do not scroll
    setTimeout(loadThirdParty, 6000);
  })();
</script>

<!-- Microsoft Clarity -->
<script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "ywef6m87rf");
</script>
