<%- include('partials/head', { title: 'এনটিআরসিএ রেজাল্ট ২০২৬ (NTRCA Result) — ফলাফল সেতু', description: 'নন-গভর্নমেন্ট টিচার্স রেজিস্ট্রেশন এন্ড সার্টিফিকেশন অথরিটি (NTRCA) শিক্ষক নিবন্ধন পরীক্ষার ফলাফল — ১৫তম, ১৬তম, ১৭তম এনটিআরসিএ ফলাফল, লিখিত ও ভাইভা।', canonical: '/ntrca-result', ogType: 'website' }) %>

<body>
  <%- include('partials/header', { activePage: 'ntrca' }) %>

  <main>
    <div class="page-hero">
      <div class="page-hero-inner">
        <h1 class="page-title">এনটিআরসিএ রেজাল্ট ২০২৬ (NTRCA Result)</h1>
        <p class="page-subtitle">নন-গভর্নমেন্ট টিচার্স রেজিস্ট্রেশন এন্ড সার্টিফিকেশন অথরিটি — শিক্ষক নিবন্ধন পরীক্ষা ফলাফল</p>
      </div>
    </div>

    <section class="result-grid">
      <div class="result-card main-board">
        <div class="result-card-header">
          <span class="badge">📝 অফিসিয়াল পোর্টাল</span>
          <h2>NTRCA ফলাফল</h2>
        </div>
        <div class="result-links">
          <a href="https://www.ntrca.gov.bd" target="_blank" rel="noopener" class="result-link primary">
            <span class="link-icon">🌐</span>
            <div>
              <strong>ntrca.gov.bd</strong>
              <small>এনটিআরসিএ অফিসিয়াল ওয়েবসাইট</small>
            </div>
          </a>
          <a href="https://ntrca.teletalk.com.bd" target="_blank" rel="noopener" class="result-link">
            <span class="link-icon">📱</span>
            <div>
              <strong>NTRCA Teletalk</strong>
              <small>আবেদন, এডমিট কার্ড ও ফলাফল পোর্টাল</small>
            </div>
          </a>
        </div>
      </div>

      <div class="result-card">
        <div class="result-card-header">
          <span class="badge">📋 পরীক্ষার ধাপ</span>
          <h2>নিবন্ধন পরীক্ষার প্রক্রিয়া</h2>
        </div>
        <div class="step-grid">
          <div class="step-item">
            <span class="step-number">১</span>
            <h3>প্রিলিমিনারি (Preliminary)</h3>
            <p>১০০ নম্বরের এমসিকিউ — বাংলা, ইংরেজি, সাধারণ জ্ঞান</p>
          </div>
          <div class="step-item">
            <span class="step-number">২</span>
            <h3>লিখিত (Written)</h3>
            <p>বিষয়ভিত্তিক লিখিত পরীক্ষা (একাধিক পেপার)</p>
          </div>
          <div class="step-item">
            <span class="step-number">৩</span>
            <h3>নিবন্ধন সনদ</h3>
            <p>সফল প্রার্থীদের শিক্ষক নিবন্ধন সনদ প্রদান</p>
          </div>
        </div>
      </div>

      <div class="result-card">
        <div class="result-card-header">
          <span class="badge">📱 এসএমএস পদ্ধতি</span>
          <h2>১৬২২২ এসএমএস ফরম্যাট</h2>
        </div>
        <div class="sms-format">
          <code>NTRCA <পরীক্ষার ধরন> <রোল> <সাল></code>
          <p>প্রিলিমিনারি: <strong>NTRCA PRE 123456 2026</strong></p>
          <p>লিখিত: <strong>NTRCA WRI 123456 2026</strong></p>
          <p>সবই পাঠান <strong>১৬২২২</strong> নম্বরে</p>
        </div>
      </div>

      <div class="result-card">
        <div class="result-card-header">
          <span class="badge">📊 সাম্প্রতিক পরীক্ষা</span>
          <h2>চলতি/সাম্প্রতিক পরীক্ষা</h2>
        </div>
        <ul class="feature-list">
          <li><strong>১৭তম NTRCA:</strong> আবেদন ও পরীক্ষা সময়সূচি</li>
          <li><strong>১৬তম NTRCA:</strong> লিখিত ফলাফল / ভাইভা সময়সূচি</li>
          <li><strong>১৫তম NTRCA:</strong> চূড়ান্ত নিবন্ধন সনদ বিতরণ</li>
        </ul>
      </div>

      <div class="result-card">
        <div class="result-card-header">
          <span class="badge">🎓 স্তরভিত্তিক ক্যাটেগরি</span>
          <h2>৩টি স্তরের নিবন্ধন</h2>
        </div>
        <div class="stats-grid">
          <div class="stat-box">
            <span class="stat-number">১</span>
            <span class="stat-label">স্কুল স্তর (৯-১০ শ্রেণি)</span>
          </div>
          <div class="stat-box">
            <span class="stat-number">২</span>
            <span class="stat-label">কলেজ স্তর (১১-১২ শ্রেণি)</span>
          </div>
          <div class="stat-box">
            <span class="stat-number">৩</span>
            <span class="stat-label">মাদ্রাসা স্তর (দাখিল/আলিম)</span>
          </div>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>