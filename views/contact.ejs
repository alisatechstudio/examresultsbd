<%- include('partials/head', { title: 'যোগাযোগ ও সহায়তা (Contact Us) — ফলাফল সেতু', description: 'ফলাফল সেতু (ExamResultsBD) কর্তৃপক্ষের সাথে যোগাযোগ করুন। যেকোনো প্রশ্ন, মতামত, বা লিংক সংক্রান্ত রিপোর্টের জন্য আমাদের সাথে যুক্ত হোন।', canonical: '/contact', ogType: 'website' }) %>

<body>
  <%- include('partials/header', { activePage: 'contact' }) %>

  <main>
    <div class="legal-container">
      <div class="legal-header">
        <h1>যোগাযোগ ও সহায়তা (Contact Us)</h1>
        <p style="color:var(--text-muted); font-size:14px; margin-top:4px;">ফলাফল সেতু সংক্রান্ত যেকোনো প্রশ্ন, মতামত, বা লিংক সংক্রান্ত ফিডব্যাক আমাদের জানান</p>
      </div>

      <div class="contact-info-grid">
        <div class="contact-card">
          <div class="icon">📧</div>
          <h3>ইমেইল সহায়তা</h3>
          <p><a href="mailto:alisatechstudio@gmail.com">alisatechstudio@gmail.com</a></p>
        </div>
        <div class="contact-card">
          <div class="icon">⚡</div>
          <h3>প্রতিক্রিয়া সময়</h3>
          <p>সাধারণত ২৪ থেকে ৪৮ ঘণ্টার মধ্যে উত্তর দেওয়া হয়</p>
        </div>
        <div class="contact-card">
          <div class="icon">🇧🇩</div>
          <h3>অবস্থান</h3>
          <p>ঢাকা, বাংলাদেশ (ExamResultsBD Team)</p>
        </div>
      </div>

      <form class="contact-form" id="portal-contact-form" onsubmit="handleContactSubmit(event)">
        <h2 style="font-size:18px; margin-bottom:16px; color:var(--text-primary);">📩 আমাদের সরাসরি বার্তা পাঠান</h2>
        <div class="form-group">
          <label for="c-name">আপনার পূর্ণ নাম *</label>
          <input type="text" id="c-name" required placeholder="আপনার নাম লিখুন">
        </div>
        <div class="form-group">
          <label for="c-email">আপনার ইমেইল অ্যাড্রেস *</label>
          <input type="email" id="c-email" required placeholder="alisatechstudio@gmail.com">
        </div>
        <div class="form-group">
          <label for="c-subject">বার্তার বিষয় *</label>
          <select id="c-subject" required>
            <option value="General Feedback">সাধারণ মতামত বা পরামর্শ</option>
            <option value="Broken Link Report">কোনো লিংক কাজ করছে না / Broken Link Report</option>
            <option value="New Exam Add Request">নতুন কোনো পরীক্ষার রেজাল্ট পোর্টাল যুক্ত করার অনুরোধ</option>
            <option value="Business Inquiry">ব্যবসায়িক যোগাযোগ বা স্পন্সরশিপ</option>
          </select>
        </div>
        <div class="form-group">
          <label for="c-message">আপনার বিস্তারিত বার্তা *</label>
          <textarea id="c-message" rows="5" required placeholder="আপনার বার্তা বিস্তারিত লিখুন..."></textarea>
        </div>
        <button type="submit" class="card-action-btn" style="width:100%; border:none; cursor:pointer; font-size:15px; font-weight:700;">বার্তা পাঠান 🚀</button>
        <div id="contact-success" style="display:none; margin-top:16px; padding:12px; background:var(--primary-light); color:var(--primary); border-radius:var(--radius-sm); font-size:14px; text-align:center; font-weight:600;">
          ✅ ধন্যবাদ! আপনার বার্তাটি গৃহীত হয়েছে। আমরা শীঘ্রই যোগাযোগ করব।
        </div>
      </form>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script>
  function handleContactSubmit(e) {
    e.preventDefault();
    const name = document.getElementById('c-name').value;
    const email = document.getElementById('c-email').value;
    const subject = document.getElementById('c-subject').value;
    const message = document.getElementById('c-message').value;
    
    // mailto fallback
    const mailtoLink = `mailto:alisatechstudio@gmail.com?subject=${encodeURIComponent(subject + ' - ' + name)}&body=${encodeURIComponent('নাম: ' + name + '\nইমেইল: ' + email + '\n\nবার্তা:\n' + message)}`;
    window.location.href = mailtoLink;
    
    document.getElementById('contact-success').style.display = 'block';
    document.getElementById('portal-contact-form').reset();
  }
  </script>
</body>
</html>